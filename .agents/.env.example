# GitHub candidate for NEW projects only. Live acceptance remains pending.
# Scripts do not auto-load this file. Export reviewed values in the caller.
# Use GitHub's official MCP endpoint; never a REST/GraphQL URL.
export GITHUB_MCP_URL="https://api.githubcopilot.com/mcp/"
# Supply GITHUB_TOKEN through your environment/secret manager, never commit it.
# Example invocation: mcp_connect "$GITHUB_MCP_URL" "$GITHUB_TOKEN" > initialize.json
# export GITHUB_OWNER="<explicit-owner>"
# export GITHUB_REPO="<explicit-repository>"
# TO DO: rename the vars below with prefix GITHUB_ (see above)
export OWNER="<explicit-owner>"
export REPO="<explicit-repository>"
# Empty selects endpoint defaults (the configuration verified for lsdd-7).
# Explicit toolset selections must be rechecked with tools/list + capability check.
export MCP_TOOLSETS=""
export MCP_PROTOCOL_VERSION="2025-06-18"
export MCP_CONNECT_TIMEOUT=10
export MCP_TIMEOUT=30
# Git SSH/HTTPS credentials are separate from the MCP token.
# WORKING_BRANCH must be supplied explicitly by the user, with no default.
