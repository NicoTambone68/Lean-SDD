# Copy to .agents/.env locally; never commit the populated file.
# Skill invocations use: uv run --no-project --env-file .agents/.env -- bash ...
# uv parses dotenv data; do not source this file or put shell commands in it.
# Optional export prefixes are supported. Inherited environment values win.
export GITHUB_MCP_URL="https://api.githubcopilot.com/mcp/"
# Add your token privately here, or supply GITHUB_TOKEN from a secret manager.
# export GITHUB_TOKEN=''
export MCP_TOOLSETS=""
export MCP_PROTOCOL_VERSION="2025-06-18"
export MCP_CONNECT_TIMEOUT=10
export MCP_TIMEOUT=30
# Empty MCP_TOOLSETS uses endpoint defaults; verify current deployed capabilities.
# Git SSH/HTTPS credentials are separate from the MCP token.
# OWNER, REPO, WORKING_BRANCH, and issue/PR identities are explicit workflow
# arguments. Bind them in the calling shell after selection/readback, not here.
